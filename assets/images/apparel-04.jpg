<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="1200" viewBox="0 0 1200 1200">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#121212"/>
      <stop offset="100%" stop-color="#080808"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bgGrad)"/>
  <rect width="100%" height="100%" fill="url(#grid)"/>

  <!-- Border & Frame -->
  <rect x="20" y="20" width="1160" height="1160" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>

  <!-- Corner Crosshairs -->
  <path d="M 15 25 L 25 25 M 20 20 L 20 30" stroke="#C8FF00" stroke-width="1.5"/>
  <path d="M 1175 25 L 1185 25 M 1180 20 L 1180 30" stroke="#C8FF00" stroke-width="1.5"/>
  <path d="M 15 1175 L 25 1175 M 20 1170 L 20 1180" stroke="#C8FF00" stroke-width="1.5"/>
  <path d="M 1175 1175 L 1185 1175 M 1180 1170 L 1180 1180" stroke="#C8FF00" stroke-width="1.5"/>

  <!-- Detail Graphic -->
  
            <!-- T-Shirt Wireframe Graphic -->
            <path d="M 420 360 L 504 300 C 552 348, 648 348, 696 300 L 780 360 L 744 504 L 683.9999999999999 480 L 683.9999999999999 864 L 516 864 L 516 480 L 456 504 Z" fill="none" stroke="#C8FF00" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6"/>
            <circle cx="600" cy="576" r="40" fill="none" stroke="#C8FF00" stroke-width="1" opacity="0.4"/>
            <text x="600" y="582" fill="#C8FF00" font-family="sans-serif" font-size="12" font-weight="bold" letter-spacing="3" text-anchor="middle" opacity="0.8">TARUN // CREATIVE GRAPHIC</text>
        

  <!-- Typography overlay -->
  <text x="40" y="55" fill="#C8FF00" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" letter-spacing="3">TARUN VERMA // PORTFOLIO ASSET</text>
  <text x="1160" y="55" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="11" text-anchor="end">1200 × 1200</text>

  <text x="600" y="983.9999999999999" fill="#FFFFFF" font-family="system-ui, -apple-system, sans-serif" font-size="24" font-weight="800" letter-spacing="2" text-anchor="middle">GRAPHIC SERIES 04</text>
  <text x="600" y="1044" fill="#C8FF00" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="600" letter-spacing="4" text-anchor="middle">CUSTOM LABEL & HEM TAG CONCEPT</text>

  <!-- Bottom metadata -->
  <text x="40" y="1165" fill="rgba(255,255,255,0.3)" font-family="monospace" font-size="10">SPEC: HIGH-RES CREATIVE ASSET</text>
  <text x="1160" y="1165" fill="rgba(255,255,255,0.3)" font-family="monospace" font-size="10" text-anchor="end">EST. 2024</text>
</svg>