<svg xmlns="http://www.w3.org/2000/svg" width="1400" height="900" viewBox="0 0 1400 900">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#121212"/>
      <stop offset="100%" stop-color="#080808"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bgGrad)"/>
  <rect width="100%" height="100%" fill="url(#grid)"/>

  <!-- Border & Frame -->
  <rect x="20" y="20" width="1360" height="860" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>

  <!-- Corner Crosshairs -->
  <path d="M 15 25 L 25 25 M 20 20 L 20 30" stroke="#C8FF00" stroke-width="1.5"/>
  <path d="M 1375 25 L 1385 25 M 1380 20 L 1380 30" stroke="#C8FF00" stroke-width="1.5"/>
  <path d="M 15 875 L 25 875 M 20 870 L 20 880" stroke="#C8FF00" stroke-width="1.5"/>
  <path d="M 1375 875 L 1385 875 M 1380 870 L 1380 880" stroke="#C8FF00" stroke-width="1.5"/>

  <!-- Detail Graphic -->
  
            <!-- Brand Identity Geometrics -->
            <polygon points="700,225 868,405 532,405" fill="none" stroke="#C8FF00" stroke-width="1.5" opacity="0.7"/>
            <circle cx="700" cy="468" r="50" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
            <rect x="616" y="414" width="168" height="108" fill="none" stroke="#C8FF00" stroke-width="1.5" transform="rotate(45 700 468)" opacity="0.6"/>
        

  <!-- Typography overlay -->
  <text x="40" y="55" fill="#C8FF00" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" letter-spacing="3">TARUN VERMA // PORTFOLIO ASSET</text>
  <text x="1360" y="55" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="11" text-anchor="end">1400 × 900</text>

  <text x="700" y="738" fill="#FFFFFF" font-family="system-ui, -apple-system, sans-serif" font-size="24" font-weight="800" letter-spacing="2" text-anchor="middle">BRAND SYSTEM</text>
  <text x="700" y="783" fill="#C8FF00" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="600" letter-spacing="4" text-anchor="middle">STATIONERY & COLLATERAL</text>

  <!-- Bottom metadata -->
  <text x="40" y="865" fill="rgba(255,255,255,0.3)" font-family="monospace" font-size="10">SPEC: HIGH-RES CREATIVE ASSET</text>
  <text x="1360" y="865" fill="rgba(255,255,255,0.3)" font-family="monospace" font-size="10" text-anchor="end">EST. 2024</text>
</svg>